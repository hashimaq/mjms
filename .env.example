# =============================================================================
# MJMS Internal Product Catalogue — Supabase configuration
# =============================================================================
# Copy to .env and fill in values from your Supabase project dashboard.
# NEVER commit .env or expose the service role key in client-side code.
# =============================================================================

# Public (safe for browser/client — required for Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side import scripts (also accepts NEXT_PUBLIC_SUPABASE_URL as fallback)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-side only (import scripts, admin tooling — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: direct Postgres connection for migrations / debugging (server-side only)
# DATABASE_URL=postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Demo authentication (UI preview only — NOT production auth)
# Set DEMO_AUTH_ENABLED=false before production deployment.
# -----------------------------------------------------------------------------
DEMO_AUTH_ENABLED=true
DEMO_ADMIN_EMAIL=admin@mjms.com
DEMO_ADMIN_PASSWORD=mjms-demo-admin

# -----------------------------------------------------------------------------
# Initial Supabase Auth users (server-only — run once: npm run bootstrap:users)
# Never use NEXT_PUBLIC_* for passwords. Do not commit real values.
# -----------------------------------------------------------------------------
MJMS_INITIAL_ADMIN_EMAIL=saad.manzoor@mjms.pk
MJMS_INITIAL_ADMIN_PASSWORD=
MJMS_INITIAL_ADMIN_FULL_NAME=Saad Manzoor
MJMS_INITIAL_EMPLOYEE_EMAIL=planner@mjms.pk
MJMS_INITIAL_EMPLOYEE_PASSWORD=
MJMS_INITIAL_EMPLOYEE_FULL_NAME=Taimoor

# -----------------------------------------------------------------------------
# Database migrations (required for create product, activity log, staff RLS)
# Apply all files in supabase/migrations/ to your Supabase project (SQL editor or
# `supabase db push`). Without them, create product uses a server fallback; apply
# migrations for full RPC + RLS (recommended for production).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Public catalogue (Day 4+)
# Category pages query articles by source_sheet when the visitor is authenticated
# (or demo session). Public anon visitors see the catalogue UI with an empty state
# until a future public read policy is added — RLS is not bypassed on public routes.
# -----------------------------------------------------------------------------
